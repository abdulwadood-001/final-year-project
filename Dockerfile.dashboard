# HoneyBot-IoT — operator dashboard (React SPA) served by Nginx
# stage 1: build the single-page app
FROM node:22-alpine AS build
WORKDIR /ui
COPY dashboard/package.json dashboard/package-lock.json dashboard/.npmrc ./
RUN npm ci --no-audit --no-fund
COPY dashboard/ ./
RUN npm run build

# stage 2: static files + reverse proxy to the API (basic auth, WebSocket upgrade)
FROM nginx:1.26-alpine
COPY nginx/nginx.conf /etc/nginx/nginx.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 80
