# HoneyBot-IoT — image for the per-device machines (protocol front-ends) + device-state
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
# same uid as the API/intel image: quarantined samples are written 0400 and must
# stay readable by the intel engine's YARA scanner
RUN useradd -m -u 10001 honey && mkdir -p /app/data /app/captures && chown -R honey /app
WORKDIR /app
COPY requirements-base.txt requirements-honeypot.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-honeypot.txt -r requirements-api.txt
COPY common/ ./common/
COPY ssh_honeypot/ ./ssh_honeypot/
COPY telnet_honeypot/ ./telnet_honeypot/
COPY http_honeypot/ ./http_honeypot/
COPY mqtt_honeypot/ ./mqtt_honeypot/
COPY rtsp_honeypot/ ./rtsp_honeypot/
COPY modbus_honeypot/ ./modbus_honeypot/
COPY device_state/ ./device_state/
COPY device_machine.py ./
USER honey
