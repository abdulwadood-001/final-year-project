FROM python:3.12-slim
RUN useradd -m -u 10002 honey && mkdir -p /app/data && chown -R honey /app
WORKDIR /app
COPY requirements-base.txt requirements-api.txt ./
RUN pip install --no-cache-dir -r requirements-api.txt
COPY common/ ./common/
COPY intel/ ./intel/
COPY alerts/ ./alerts/
COPY api/ ./api/
COPY geoip/ ./geoip/
USER honey
EXPOSE 5000
CMD ["python","-m","uvicorn","api.api:app","--host","127.0.0.1","--port","5000"]
