{
  "name": "honeybot-iot-dashboard",
  "version": "0.7.0",
  "private": true,
  "type": "module",
  "description": "HoneyBot-IoT operator dashboard (React + TanStack Router SPA, served by Nginx)",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
