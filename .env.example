# ─────────────────────────────────────────────────────────────────────────
#  HoneyBot-IoT — environment configuration
#  Copy to `.env` (which is git-ignored) and fill in your own secrets.
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# ── Database (change the password for any real deployment) ──────────────────
POSTGRES_DB=honeybot
POSTGRES_USER=honeybot
POSTGRES_PASSWORD=change_me_please_7f3a9c
DATABASE_URL=postgresql://honeybot:change_me_please_7f3a9c@db:5432/honeybot

# ── Redis (device state + live event bus) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Dashboard HTTP basic-auth (Nginx). Generate the hash with:
#     docker run --rm httpd:alpine htpasswd -nbB admin 'your-password'
#  then paste the admin:$2y$... line into nginx/.htpasswd
DASHBOARD_USER=admin

# ── Detection tuning ────────────────────────────────────────────────────────
BF_WINDOW_MIN=10
BF_THRESHOLD=5
INTEL_INTERVAL=30

# ── GeoIP ───────────────────────────────────────────────────────────────────
# true  → lab/private IPs get a deterministic DEMO location (clearly marked)
# false → private IPs are left unlocated; only real public IPs are mapped
GEO_DEMO_MODE=true

# ── Alerts: Telegram (optional) ─────────────────────────────────────────────
# Create a bot with @BotFather, then message it and read the chat id from
#   https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alerts: e-mail / SMTP (optional) ────────────────────────────────────────
# For Gmail use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=honeybot@localhost
ALERT_EMAIL_TO=
