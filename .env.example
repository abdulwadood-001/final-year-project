# ─────────────────────────────────────────────────────────────────────────
#  HoneyBot-IoT v0.7 — environment configuration
#  Copy to `.env` (which is git-ignored) and fill in your own secrets.
#      cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────

# ── Database (change the password for any real deployment) ──────────────────
POSTGRES_DB=honeybot
POSTGRES_USER=honeybot
POSTGRES_PASSWORD=change_me_please_7f3a9c
DATABASE_URL=postgresql://honeybot:change_me_please_7f3a9c@db:5432/honeybot

# ── Redis (device state + live event bus) ───────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── Dashboard login (Nginx basic auth, stored as a bcrypt hash) ─────────────
# Leave DASHBOARD_PASSWORD empty to get a random one on first start:
#     docker compose logs auth-init
DASHBOARD_USER=admin
DASHBOARD_PASSWORD=
DASHBOARD_PORT=80

# ── Network isolation ───────────────────────────────────────────────────────
# The `firewall` service drops every connection a honeypot tries to OPEN.
# Only set HONEYBOT_FIREWALL=off on a machine where that is impossible (e.g.
# rootless Docker) and never expose such a setup to the internet.
HONEYBOT_FIREWALL=on
HONEYNET_SUBNET=172.31.66.0/24
BACKNET_SUBNET=172.31.67.0/24

# ── Detection tuning ────────────────────────────────────────────────────────
BF_WINDOW_MIN=10
BF_THRESHOLD=5
INTEL_INTERVAL=30

# ── Malware capture (quarantine volume, YARA-scanned by the intel engine) ───
CAPTURE_MAX_BYTES=10485760

# ── GeoIP ───────────────────────────────────────────────────────────────────
# Real locations need an offline database:  deploy/get_geoip.sh
# GEO_DEMO_MODE=true gives LAB / private IPs a deterministic DEMO location so the
# map works in the lab. These rows are marked geo_source='demo' and the dashboard
# labels them "DEMO". Set to false for any real deployment.
GEO_DEMO_MODE=true

# ── Alerts: Telegram (optional) ─────────────────────────────────────────────
# Create a bot with @BotFather, then message it and read the chat id from
#   https://api.telegram.org/bot<token>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── Alerts + daily/weekly PDF reports: e-mail / SMTP (optional) ─────────────
# For Gmail use an App Password (not your account password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=honeybot@localhost
ALERT_EMAIL_TO=
# hour (UTC) after which the daily report is e-mailed; weekly report on Mondays
REPORT_HOUR_UTC=6

# ── Backups (./backups on the host) ─────────────────────────────────────────
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=7

# ── Monitoring profile (docker compose --profile monitoring up -d) ──────────
GRAFANA_ADMIN_PASSWORD=change_me_grafana
